<?php

/**
 * Implements hook_schema().
 */
function ebms_core_schema(): array {
  return [
    'on_demand_config' => [
      'description' => 'Configuration values which we only want loaded when they are explicitly requested, and which we do not want to be controlled by the Drupal cache system.',
      'fields' => [
        'name' => [
          'description' => 'Unique name of the configuration (for example, article-type-ancestors).',
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
        ],
        'value' => [
          'description' => 'JSON-encoded value for the configuration.',
          'type' => 'text',
          'size' => 'normal',
        ],
      ],
      'primary key' => ['name'],
    ],
  ];
}

/**
 * Migrate legacy authmap entries to externalauth_authmap.
 */
function ebms_core_update_9001() {
  $authmap_service = \Drupal::service('externalauth.authmap');
  $db = \Drupal::database();

  if ($db->schema()->tableExists('authmap')) {
    $results = $db->query("SELECT uid, authname FROM {authmap}")->fetchAll();
    foreach ($results as $row) {
      $account = \Drupal\user\Entity\User::load($row->uid);
      if ($account && !$authmap_service->getAuthname($row->uid, 'samlauth')) {
        $authmap_service->save($account, 'samlauth', $row->authname);
      }
    }
  }
}
